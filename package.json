{
  "name": "kaashify",
  "version": "1.3.0",
  "private": true,
  "description": "Browser extension: your Kalshi positions on a calendar, plus realized P&L. Read-only, uses your own API key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . && tsc -p tests",
    "test": "node --test tests/*.test.ts",
    "e2e": "npm run build && playwright test -c e2e",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
